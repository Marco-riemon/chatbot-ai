# ========================================================
# AI GATEWAY & MULTI-PROVIDER CHATBOT ENVIRONMENT CONFIG
# ========================================================

# App Configuration
PORT=3000
NODE_ENV=development

# --------------------------------------------------------
# 1. GROQ PROVIDER
# Console: https://console.groq.com/
# Multiple API keys supported for automatic rotation & fallback
# --------------------------------------------------------
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --------------------------------------------------------
# 2. GOOGLE GEMINI PROVIDER
# Console: https://aistudio.google.com/
# --------------------------------------------------------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# --------------------------------------------------------
# 3. OPENROUTER PROVIDER
# Console: https://openrouter.ai/
# --------------------------------------------------------
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# --------------------------------------------------------
# 4. CLOUDFLARE WORKERS AI PROVIDER
# Console: https://dash.cloudflare.com/
# --------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --------------------------------------------------------
# 5. NVIDIA NIM PROVIDER
# Console: https://build.nvidia.com/
# --------------------------------------------------------
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=

# Gateway Configuration
GATEWAY_DEFAULT_PROVIDER=groq
GATEWAY_MAX_RETRIES=3
GATEWAY_TIMEOUT_MS=30000
GATEWAY_COOLDOWN_SECONDS=60

